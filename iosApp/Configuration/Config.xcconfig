// Apple Developer Team ID (developer.apple.com/account -> Membership details -> Team ID). Used for automatic signing.
TEAM_ID=847G8T4DZC
// Bundle identifier registered in the developer portal / App Store Connect.
BUNDLE_ID=github.sushkpavel.studentbsuby
// Debug builds get their own App ID: it can be signed by any team (including a free
// Personal Team) without taking the release identifier, and installs next to the store app.
BUNDLE_ID_SUFFIX[config=Debug]=.dev
// Apple ID of the app (App Store Connect -> App Information -> Apple ID, digits only).
// Known as soon as the app record is created; used for "update" links to the App Store.
APP_STORE_ID=
// Full application name (App Store, system dialogs that show CFBundleName).
APP_NAME=Кабинет студента БГУ
// Short label under the icon on the home screen: iOS shows a single line about the
// width of the icon and squeezes/truncates anything longer than ~12 characters.
APP_DISPLAY_NAME=Студент БГУ
